rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The super admin. Change this email to match SUPER_ADMIN_EMAIL in
    // public/firebase-config.js.
    function isSuperAdmin() {
      return request.auth != null
        && request.auth.token.email == 'gizee@giazonest.com';
    }
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    // Shoppers have a profile at buyers/{uid}. Seller and partner accounts don't,
    // unless a seller ticked "I also want to shop as a buyer" on the Sellers page.
    function isBuyer() {
      return signedIn() && exists(/databases/$(database)/documents/buyers/$(request.auth.uid));
    }
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    // GiaZoNest partners (GiZee), enrolled by the super admin at partners/{uid}.
    function partner() {
      return get(/databases/$(database)/documents/partners/$(request.auth.uid)).data;
    }
    function isVerifiedPartner() {
      return signedIn()
        && exists(/databases/$(database)/documents/partners/$(request.auth.uid))
        && partner().status == 'Verified';
    }

    // Full seller records, including KYC numbers. Sellers who sign up keep
    // theirs at sellers/{their uid}: they can read and edit it, but they
    // can't approve themselves, and verified KYC numbers are locked.
    match /sellers/{id} {
      allow read, write: if isSuperAdmin();
      allow get: if isOwner(id);
      allow create: if isOwner(id)
        && request.resource.data.status == 'Pending KYC'
        && request.resource.data.ownerUid == request.auth.uid
        && !request.resource.data.keys().hasAny(['kycReviewedAt', 'kycReviewedBy', 'kycNote', 'example']);
      allow update: if isOwner(id)
        && !changed().hasAny(['kycReviewedAt', 'kycReviewedBy', 'kycNote', 'ownerUid', 'example'])
        && (request.resource.data.status == resource.data.status
            || (resource.data.status == 'KYC Rejected' && request.resource.data.status == 'Pending KYC'))
        && !(resource.data.status in ['Verified', 'Suspended'] && changed().hasAny(['kyc']));
      // A partner whose KYC is approved can enroll sellers and see the ones they enrolled.
      allow read: if signedIn() && resource.data.partnerUid == request.auth.uid;
      allow create: if isVerifiedPartner()
        && request.resource.data.partnerUid == request.auth.uid
        && request.resource.data.partnerId == partner().partnerId
        && request.resource.data.status == 'Pending KYC'
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.feeDiscount is int
        && request.resource.data.feeDiscount >= 0 && request.resource.data.feeDiscount <= 100
        && !request.resource.data.keys().hasAny(['ownerUid', 'kyc', 'kycReviewedAt', 'kycReviewedBy', 'kycNote', 'example']);
    }
    // Partner records: Partner ID, name, date of birth, mobile, PAN and Aadhaar last 4 only.
    // A partner creates their own account and record; the super admin approves.
    // A partner can read their own, and edit it until approved, but can't approve
    // themselves or change their Aadhaar, Partner ID or email.
    function validPartner(p) {
      return p.type == 'GiZee'
        && p.name is string && p.name.size() > 0 && p.name.size() <= 80
        && p.dob is string && p.dob.matches('[0-9]{2}/[0-9]{2}/[0-9]{4}')
        && p.mobile is string && p.mobile.matches('[6-9][0-9]{9}')
        && p.pan is string && p.pan.matches('[A-Z]{5}[0-9]{4}[A-Z]')
        && p.address is string && p.address.size() <= 300;
    }
    match /partners/{id} {
      allow read, write: if isSuperAdmin();
      allow get: if isOwner(id);
      allow create: if isOwner(id)
        && validPartner(request.resource.data)
        && request.resource.data.status == 'Pending KYC'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.aadhaarLast4.matches('[0-9]{4}')
        && request.resource.data.partnerId.matches('[A-Z]{3}-' + request.resource.data.aadhaarLast4 + '-[0-9]{6}(-[0-9]+)?')
        && getAfter(/databases/$(database)/documents/partnerIds/$(request.resource.data.partnerId)).data.uid == id
        && request.resource.data.enrolledAt == request.time
        && !request.resource.data.keys().hasAny(['kycReviewedAt', 'kycReviewedBy', 'kycNote', 'enrolledBy']);
      allow update: if isOwner(id)
        && validPartner(request.resource.data)
        && resource.data.status in ['Pending KYC', 'KYC Rejected']
        && request.resource.data.status == 'Pending KYC'
        && !changed().hasAny(['partnerId', 'aadhaarLast4', 'email', 'enrolledAt', 'enrolledBy', 'kycReviewedAt', 'kycReviewedBy', 'kycNote']);
    }
    // Partner ID -> partner uid, so no two partners get the same ID.
    match /partnerIds/{pid} {
      allow read, write: if isSuperAdmin();
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/partners/$(request.auth.uid)).data.partnerId == pid;
    }
    // KYC-verified sellers without KYC numbers. Shoppers can read; a seller
    // can check their own listing. The admin console keeps this in sync.
    match /publicSellers/{id} {
      allow read: if isBuyer();
      allow get: if isOwner(id);
      allow write: if isSuperAdmin();
    }
    // Products. Shoppers see only live ones: the seller is verified and GiaZoNest
    // approved the product. Each new or edited product (details or photos) waits
    // in review ("Pending") until the super admin approves it. Products saved
    // before reviews existed have no review field and count as approved.
    function reviewOf(p) {
      return p.get('review', 'Approved');
    }
    // A seller whose KYC the super admin has verified.
    function isVerifiedSeller() {
      return signedIn()
        && exists(/databases/$(database)/documents/sellers/$(request.auth.uid))
        && get(/databases/$(database)/documents/sellers/$(request.auth.uid)).data.status == 'Verified';
    }
    function validProduct() {
      let p = request.resource.data;
      return p.sellerId == request.auth.uid
        && p.name is string && p.name.size() > 0 && p.name.size() <= 80
        && p.price is number && p.price >= 0
        && p.discount is number && p.discount >= 0 && p.discount <= p.price
        && p.stock is int && p.stock >= 0
        && p.sold is int && p.sold >= 0
        && p.live == (reviewOf(p) == 'Approved'
          && exists(/databases/$(database)/documents/publicSellers/$(request.auth.uid)));
    }
    match /products/{pid} {
      allow read, write: if isSuperAdmin();
      allow read: if signedIn() && resource.data.sellerId == request.auth.uid;
      allow read: if isBuyer() && resource.data.live == true;
      allow create: if signedIn() && validProduct()
        && request.resource.data.review == 'Pending'
        && !request.resource.data.keys().hasAny(['reviewedAt', 'reviewedBy', 'reviewNote']);
      // Selling one (stock and sold counts) keeps the review. A verified seller changing
      // only the photos of an approved product keeps the approval too. Any other change
      // goes back to review.
      allow update: if signedIn() && resource.data.sellerId == request.auth.uid && validProduct()
        && !changed().hasAny(['reviewedAt', 'reviewedBy', 'reviewNote'])
        && (changed().hasOnly(['stock', 'sold', 'live', 'updatedAt'])
            || (changed().hasOnly(['stock', 'live', 'updatedAt', 'photoCount', 'thumb'])
                && reviewOf(resource.data) == 'Approved' && isVerifiedSeller())
            || request.resource.data.review == 'Pending');
      allow delete: if signedIn() && resource.data.sellerId == request.auth.uid;
    }
    // Product photos, one per document, shrunk in the browser. A seller can add
    // or replace photos on a product that is waiting for review, and, once their
    // KYC is verified, on an approved product without another review.
    match /productImages/{iid} {
      allow read: if isSuperAdmin() || isBuyer()
        || (signedIn() && resource.data.sellerId == request.auth.uid);
      allow write: if isSuperAdmin();
      function validPhoto() {
        let product = getAfter(/databases/$(database)/documents/products/$(request.resource.data.productId)).data;
        return request.resource.data.sellerId == request.auth.uid
          && request.resource.data.data is string
          && request.resource.data.data.size() < 400000
          && product.sellerId == request.auth.uid
          && (reviewOf(product) == 'Pending'
              || (reviewOf(product) == 'Approved' && isVerifiedSeller()));
      }
      allow create: if signedIn() && validPhoto();
      allow update: if signedIn() && resource.data.sellerId == request.auth.uid && validPhoto();
      allow delete: if signedIn() && resource.data.sellerId == request.auth.uid;
    }
    // User ID -> email, so shoppers can sign in with their user ID.
    match /usernames/{name} {
      allow get: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow read, write: if isSuperAdmin();
    }
    // Shopper profiles. Each shopper can read and edit their own, but not
    // their order count or status.
    match /buyers/{uid} {
      allow read, write: if isSuperAdmin();
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.status == 'New'
        && request.resource.data.orders == 0;
      allow update: if isOwner(uid)
        && request.resource.data.status == resource.data.status
        && request.resource.data.orders == resource.data.orders;
      // A seller who unticks "I also want to shop as a buyer" removes the profile
      // that the Sellers page made for them.
      allow delete: if isOwner(uid) && resource.data.fromSeller == true;
    }
    // Star ratings and optional feedback, one per shopper per seller, kept at
    // reviews/{sellerId}_{shopper uid}. Signed-in people can read them; a
    // shopper can write and delete only their own, and only for a verified shop.
    match /reviews/{rid} {
      function validReview() {
        let r = request.resource.data;
        return rid == r.sellerId + '_' + request.auth.uid
          && r.uid == request.auth.uid
          && r.sellerId != request.auth.uid
          && r.stars is int && r.stars >= 1 && r.stars <= 5
          && r.text is string && r.text.size() <= 500
          && r.name is string && r.name.size() <= 80
          && exists(/databases/$(database)/documents/publicSellers/$(r.sellerId));
      }
      allow read: if signedIn();
      allow create, update: if signedIn() && validReview();
      allow delete: if isSuperAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }
    // Everything else stays closed until a rule opens it.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
