rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the super admin can read or write. Change this email to match
    // SUPER_ADMIN_EMAIL in public/firebase-config.js.
    function isSuperAdmin() {
      return request.auth != null
        && request.auth.token.email == 'vishalsaxen@gmail.com';
    }

    match /sellers/{id} {
      allow read, write: if isSuperAdmin();
    }
    match /buyers/{id} {
      allow read, write: if isSuperAdmin();
    }
    // Everything else stays closed until a rule opens it.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
